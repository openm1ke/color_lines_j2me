#!/bin/sh
# Convenience launcher; bootstrap, build and checks run on Java.
set -eu
PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${JAVA_HOME:-}" ]; then
    JAVA_CMD="$JAVA_HOME/bin/java"
else
    JAVA_CMD=java
fi
exec "$JAVA_CMD" "$PROJECT_ROOT/tools/AntBootstrap.java" --project-root "$PROJECT_ROOT" "$@"
