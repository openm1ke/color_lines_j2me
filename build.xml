<?xml version="1.0" encoding="UTF-8"?>
<project name="lines-j2me" default="run-freej2me" basedir=".">
  <property file="local.properties"/>

  <property name="build.compiler" value="org.eclipse.jdt.core.JDTCompilerAdapter"/>
  <property name="emulator.width" value="240"/>
  <property name="emulator.height" value="320"/>
  <property name="emulator.scale" value="2"/>
  <property name="src.dir" value="src"/>
  <property name="res.dir" value="res"/>
  <property name="build.dir" value="build"/>
  <property name="classes.dir" value="${build.dir}/classes"/>
  <property name="prever.dir" value="${build.dir}/preverified"/>
  <property name="dist.dir" value="dist"/>


  <!-- Компилим строго против CLDC/MIDP-стабов -->
  <path id="bootcp">
    <pathelement location="lib/cldcapi11.jar"/>
    <pathelement location="lib/midpapi20.jar"/>
  </path>

  <target name="clean">
    <delete dir="${build.dir}"/>
    <delete dir="${dist.dir}"/>
  </target>

  <target name="prepare">
    <delete dir="${classes.dir}"/>
    <mkdir dir="${classes.dir}"/>
    <mkdir dir="${prever.dir}"/>
    <mkdir dir="${dist.dir}"/>
  </target>

  <!-- Компиляция древнего байткода -->
  <target name="compile" depends="prepare">
    <javac srcdir="${src.dir}" destdir="${classes.dir}"
           source="1.3" target="1.1" encoding="UTF-8" debug="true" includeantruntime="false"
           bootclasspathref="bootcp"/>
  </target>

  <!-- CLDC preverification with the bundled ProGuard. -->
  <target name="preverify" depends="compile">
    <delete dir="${prever.dir}"/>
    <java jar="tools/proguard/lib/proguard.jar" fork="true" failonerror="true" dir="${basedir}">
      <arg value="@proguard.pro"/>
    </java>
  </target>

  <!-- Перед упаковкой кладём ресурсы (PNG) в preverified-вывод -->
  <target name="copy-res" depends="preverify">
    <copy todir="${prever.dir}">
      <fileset dir="${res.dir}">
        <include name="**/*"/>
      </fileset>
    </copy>
  </target>

  <!-- Упаковка JAR с манифестом MIDP -->
  <target name="jar" depends="copy-res">
    <jar destfile="${dist.dir}/${suite.name}.jar" basedir="${prever.dir}">
      <manifest>
        <attribute name="MIDlet-Name" value="${suite.name}"/>
        <attribute name="MIDlet-Vendor" value="${vendor}"/>
        <attribute name="MIDlet-Version" value="${version}"/>
        <attribute name="MicroEdition-Configuration" value="CLDC-${cldc.config}"/>
        <attribute name="MicroEdition-Profile" value="MIDP-${midp.profile}"/>
        <attribute name="MIDlet-1" value="${midlet.display}, , ${midlet.class}"/>
      </manifest>
    </jar>
  </target>

  <!-- JAD с правильным размером JAR -->
  <target name="jad" depends="jar">
    <length property="jar.size" file="${dist.dir}/${suite.name}.jar"/>
    <echo file="${dist.dir}/${suite.name}.jad">
MIDlet-Name: ${suite.name}
MIDlet-Vendor: ${vendor}
MIDlet-Version: ${version}
MicroEdition-Configuration: CLDC-${cldc.config}
MicroEdition-Profile: MIDP-${midp.profile}
MIDlet-1: ${midlet.display}, , ${midlet.class}
MIDlet-Jar-URL: ${suite.name}.jar
MIDlet-Jar-Size: ${jar.size}
    </echo>
  </target>

  <target name="package" depends="jad"/>

  <!-- Запуск MicroEmulator с JAD -->
  <target name="run-microemulator" depends="package">
    <java classname="org.microemu.app.Main" fork="true">
      <classpath>
        <pathelement location="tools/microemulator.jar"/>
      </classpath>
      <arg value="${dist.dir}/${suite.name}.jad"/>
    </java>
  </target>

    <target name="run-jar" depends="package">
        <java classname="org.microemu.app.Main" fork="true" dir="${basedir}">
            <classpath>
                <pathelement location="tools/microemulator.jar"/>
            </classpath>
            <arg value="${dist.dir}/${suite.name}.jar"/>
        </java>
    </target>

  <target name="run-freej2me" depends="package">
    <java jar="tools/freej2me.jar" fork="true" failonerror="true" dir="${basedir}">
      <jvmarg value="-Dfile.encoding=ISO_8859_1"/>
      <arg value="${basedir}/${dist.dir}/${suite.name}.jar"/>
      <arg value="0"/>
      <arg value="${emulator.width}"/>
      <arg value="${emulator.height}"/>
      <arg value="${emulator.scale}"/>
    </java>
  </target>
  <target name="run" depends="run-freej2me" description="Build and run FreeJ2ME"/>
  <target name="compile-checks">
    <mkdir dir="${build.dir}/tool-classes"/>
    <mkdir dir="${build.dir}/tests"/>
    <!-- The host checks use the current JDK, not the legacy game compiler. -->
    <javac srcdir="tools/buildsrc" destdir="${build.dir}/tool-classes"
           compiler="modern" fork="true" encoding="UTF-8" release="17" includeantruntime="false"/>
    <javac srcdir="tests" destdir="${build.dir}/tests"
           compiler="modern" fork="true" encoding="UTF-8" release="17" includeantruntime="false">
      <classpath>
        <pathelement location="${classes.dir}"/>
        <pathelement location="tools/freej2me.jar"/>
      </classpath>
    </javac>
  </target>

  <macrodef name="game-check">
    <attribute name="class"/>
    <attribute name="store"/>
    <attribute name="marker"/>
    <sequential>
      <local name="check.result"/><local name="check.output"/><local name="check.errors"/>
      <java classname="@{class}" fork="true" dir="${basedir}" timeout="60000"
            resultproperty="check.result" outputproperty="check.output" errorproperty="check.errors">
        <classpath>
          <pathelement location="${build.dir}/tests"/>
          <pathelement location="${classes.dir}"/>
          <pathelement location="tools/freej2me.jar"/>
        </classpath>
        <jvmarg value="-Dfile.encoding=ISO_8859_1"/>
        <sysproperty key="lines.store" value="@{store}"/>
        <sysproperty key="java.awt.headless" value="true"/>
      </java>
      <echo message="${check.output}"/><echo message="${check.errors}"/>
      <fail message="@{class} failed or exited before completion">
        <condition><not><and>
          <equals arg1="${check.result}" arg2="0"/>
          <contains string="${check.output}" substring="@{marker}"/>
        </and></not></condition>
      </fail>
    </sequential>
  </macrodef>

  <target name="test" depends="package,compile-checks" description="Check packaging and gameplay regressions using Java">
    <java classname="DistributionCheck" fork="true" failonerror="true" dir="${basedir}">
      <classpath><pathelement location="${build.dir}/tool-classes"/></classpath>
      <arg value="${dist.dir}/${suite.name}.jar"/><arg value="${dist.dir}/${suite.name}.jad"/>
    </java>
    <game-check class="GameplayCheck" store="lines-automated-check" marker="ALL GAMEPLAY CHECKS PASSED"/>
    <game-check class="FeatureCheck" store="lines-feature-check" marker="ALL FEATURE CHECKS PASSED"/>
    <game-check class="ProgressionCheck" store="lines-journey-check" marker="ALL PROGRESSION CHECKS PASSED"/>
  </target>
  <target name="check-emulator" depends="test" description="Run visible FreeJ2ME scenarios in isolated test saves">
    <java classname="EmulatorSuite" fork="true" failonerror="true" dir="${basedir}">
      <classpath><pathelement location="${build.dir}/tool-classes"/></classpath>
    </java>
  </target>
</project>

